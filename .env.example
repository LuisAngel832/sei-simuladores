# SEI - Simuladores - Plantilla de configuracion
# Copia este archivo a .env y ajusta los valores segun la red del lab.
# El .env es la unica fuente de IPs — los scripts de arranque lo leen
# automaticamente y exportan las variables al entorno antes de lanzar python.

# ── Broker EMQX ──
MQTT_HOST=192.168.1.100
MQTT_PORT=1883

# ── Backend Spring Boot (panel usa POST /api/login) ──
BACKEND_HOST=192.168.1.100
BACKEND_PORT=8080
BACKEND_LOGIN_TIMEOUT_S=3.0

# ── Parametros del simulador (opcionales — defaults en sensores.py) ──
SEI_SIM_RUIDO=0.3
SEI_SIM_PROB_VISITA=0.04
SEI_SIM_VISITA_MIN_CICLOS=2
SEI_SIM_VISITA_MAX_CICLOS=5
