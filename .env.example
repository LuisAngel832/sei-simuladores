# SEI - Simuladores - Variables de entorno
# Copiar este archivo a .env y ajustar los valores segun la red del laboratorio.
# Todas las variables se leen via os.getenv(); si no se definen se usa el default
# documentado en cada modulo Python.

# ── Broker EMQX ────────────────────────────────────────────────────────────────

# Host del broker EMQX (IP del Servidor SEI en la LAN)
# Default: 192.168.1.100  (definido en mqtt_broker.py y panel/publisher.py)
MQTT_HOST=192.168.1.100

# Puerto MQTT TCP del broker
# Default: 1883
MQTT_PORT=1883

# URL del dashboard EMQX (solo referencia informativa, no de conexion)
# Default: http://${MQTT_HOST}:18083
MQTT_DASHBOARD_URL=http://192.168.1.100:18083

# ── Backend Spring Boot (solo usado por el panel para login real) ─────────────

# Host del backend Spring Boot. Si no se define, hereda MQTT_HOST.
BACKEND_HOST=

# Puerto REST del backend
# Default: 8080
BACKEND_PORT=8080

# URL completa del backend (override directo). Si se define, ignora BACKEND_HOST/PORT.
# Default: http://${BACKEND_HOST}:${BACKEND_PORT}
BACKEND_URL=

# Timeout del POST /api/login en segundos
# Default: 3.0
BACKEND_LOGIN_TIMEOUT_S=3.0

# ── Parametros del simulador de sensores ──────────────────────────────────────

# Amplitud del ruido aleatorio del sensor de temperatura, en grados Celsius.
# T-01-02 (Sprint 1) pide +/-0.3 C como variacion por ciclo.
# Default: 0.3
SEI_SIM_RUIDO=0.3

# Probabilidad por ciclo de iniciar una "visita" del sensor de presencia.
# Default: 0.04  (4% por ciclo en reposo)
SEI_SIM_PROB_VISITA=0.04

# Duracion minima de una visita simulada, en ciclos (~30s por ciclo).
# Default: 2  (aprox 60s)
SEI_SIM_VISITA_MIN_CICLOS=2

# Duracion maxima de una visita simulada, en ciclos.
# Default: 5  (aprox 150s)
SEI_SIM_VISITA_MAX_CICLOS=5
